# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/bagpipe
TEST_DATABASE_URL=postgresql://localhost:5432/bagpipe_test

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed

# Bags.fm
BAGS_API_KEY=your_bags_api_key
BAGS_API_URL=https://public-api-v2.bags.fm

# Scheduler
SCHEDULER_TICK_MS=10000
SCHEDULER_ENABLED=true

# Decider
DECIDER_TIMEOUT_MS=30000

# Escrow Keys (one per pipe)
# ESCROW_KEY_pipe_abc123=base58_private_key
